<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sahil.controller.BillingController">

    <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>

    <Label text="Billing" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Search Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 14;">
        <Label text="Booking ID:"/>
        <TextField fx:id="txtBillingBookingId" promptText="e.g. B001" prefWidth="180"/>
        <Button text="Generate Bill" onAction="#generateBill"/>
        <Button text="Reset" onAction="#resetBilling"/>
        <Label fx:id="lblBillingMsg"/>
    </HBox>

    <!-- Bill Display -->
    <VBox fx:id="billPane" spacing="0"
          style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5;"
          VBox.vgrow="ALWAYS">

        <!-- Bill Header -->
        <VBox alignment="CENTER" spacing="4"
              style="-fx-background-color: #2c3e50; -fx-padding: 16;">
            <Label text="Hotel Management System"
                   style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="Bill / Invoice"
                   style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
        </VBox>

        <!-- Guest and Booking Info -->
        <HBox spacing="0">

            <!-- Left: Customer Details -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 16; -fx-border-color: #ecf0f1; -fx-border-width: 0 1 1 0;">
                <Label text="BILLED TO" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                <Label fx:id="lblBillCustomerName" text="—" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblBillContact"      text="—" style="-fx-text-fill: #555;"/>
            </VBox>

            <!-- Right: Booking Details -->
            <VBox spacing="6" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 16; -fx-border-color: #ecf0f1; -fx-border-width: 0 0 1 0;">
                <Label text="BOOKING DETAILS" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
                <HBox spacing="8">
                    <Label text="Booking ID:" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="lblBillBookingId" text="—" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Room Number:" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="lblBillRoomNumber" text="—"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Room Type:" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="lblBillRoomType" text="—"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="Number of Days:" style="-fx-text-fill: #7f8c8d;"/>
                    <Label fx:id="lblBillDays" text="—"/>
                </HBox>
            </VBox>
        </HBox>

        <!-- Charges Breakdown Table -->
        <VBox style="-fx-padding: 16 16 8 16;">
            <Label text="CHARGES" style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d;"/>
        </VBox>

        <TableView fx:id="tblCharges" prefHeight="130">
            <columns>
                <TableColumn fx:id="colChargeDesc"   text="Description"  prefWidth="320"/>
                <TableColumn fx:id="colChargeQty"    text="Days"         prefWidth="80"/>
                <TableColumn fx:id="colChargeRate"   text="Rate (Rs.)"   prefWidth="140"/>
                <TableColumn fx:id="colChargeAmount" text="Amount (Rs.)" prefWidth="140"/>
            </columns>
            <placeholder><Label text="No bill generated yet."/></placeholder>
        </TableView>

        <!-- Totals Section -->
        <VBox spacing="8" style="-fx-padding: 16 24 20 16; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0;">
            <HBox spacing="0">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Room Charges:" style="-fx-text-fill: #555;" minWidth="160"/>
                <Label fx:id="lblSubtotal" text="Rs. 0.00" minWidth="120"/>
            </HBox>
            <HBox spacing="0">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Tax (18%):" style="-fx-text-fill: #555;" minWidth="160"/>
                <Label fx:id="lblTax" text="Rs. 0.00" minWidth="120"/>
            </HBox>
            <Separator/>
            <HBox spacing="0">
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="TOTAL:" style="-fx-font-weight: bold; -fx-font-size: 14px;" minWidth="160"/>
                <Label fx:id="lblGrandTotal" text="Rs. 0.00"
                       style="-fx-font-weight: bold; -fx-font-size: 14px;" minWidth="120"/>
            </HBox>
        </VBox>

    </VBox>

</VBox>
