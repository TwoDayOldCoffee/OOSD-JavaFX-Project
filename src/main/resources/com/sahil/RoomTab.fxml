<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sahil.controller.RoomController">

    <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>

    <Label text="Room Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Add Room Form -->
    <VBox spacing="12"
          style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 16;">

        <Label text="Add New Room" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

        <GridPane hgap="12" vgap="10">

            <Label text="Room Number:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtRoomNumber" promptText="e.g. 101"
                       GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="140"/>

            <Label text="Room Type:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbRoomType" promptText="Select type"
                      GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="140"/>

            <Label text="Price Per Day (Rs.):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtRoomPrice" promptText="e.g. 1500"
                       GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="140"/>

            <Label fx:id="lblRoomMsg" GridPane.columnIndex="0" GridPane.rowIndex="2"
                   GridPane.columnSpan="4"/>
        </GridPane>

        <HBox spacing="10">
            <Button text="Add Room" onAction="#addRoom"/>
            <Button text="Clear" onAction="#clearRoomForm"/>
        </HBox>
    </VBox>

    <!-- Filter Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Show:"/>
        <ComboBox fx:id="cmbFilterStatus" prefWidth="160"/>
        <Button text="Apply Filter" onAction="#applyFilter"/>
        <Button text="Show All" onAction="#showAll"/>
    </HBox>

    <!-- Rooms Table -->
    <TableView fx:id="tblRooms" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRoomNumber"  text="Room Number"  prefWidth="130"/>
            <TableColumn fx:id="colRoomType"    text="Room Type"    prefWidth="130"/>
            <TableColumn fx:id="colRoomPrice"   text="Price/Day"    prefWidth="130"/>
            <TableColumn fx:id="colRoomStatus"  text="Status"       prefWidth="130"/>
        </columns>
        <placeholder><Label text="No rooms added yet."/></placeholder>
    </TableView>

</VBox>
