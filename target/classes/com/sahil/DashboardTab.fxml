<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sahil.controller.DashboardController">

    <padding><Insets top="30" bottom="30" left="30" right="30"/></padding>

    <Label text="Dashboard" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Overview of the hotel's current state."
           style="-fx-text-fill: #7f8c8d;"/>

    <!-- Summary Cards Row -->
    <HBox spacing="16">

        <!-- Total Rooms -->
        <VBox style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 20;"
              spacing="6" alignment="CENTER" prefWidth="160">
            <Label text="Total Rooms" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblTotalRooms" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Available Rooms -->
        <VBox style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 20;"
              spacing="6" alignment="CENTER" prefWidth="160">
            <Label text="Available" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblAvailableRooms" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </VBox>

        <!-- Occupied Rooms -->
        <VBox style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 20;"
              spacing="6" alignment="CENTER" prefWidth="160">
            <Label text="Occupied" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblOccupiedRooms" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
        </VBox>

        <!-- Total Customers -->
        <VBox style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 20;"
              spacing="6" alignment="CENTER" prefWidth="160">
            <Label text="Customers" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblTotalCustomers" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Active Bookings -->
        <VBox style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 20;"
              spacing="6" alignment="CENTER" prefWidth="160">
            <Label text="Active Bookings" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Label fx:id="lblActiveBookings" text="0"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
        </VBox>

    </HBox>

    <!-- Refresh Button -->
    <HBox>
        <Button text="Refresh Dashboard" onAction="#refreshDashboard"/>
    </HBox>

    <!-- Recent Bookings Table -->
    <Label text="Recent Active Bookings" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <TableView fx:id="tblRecentBookings" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDashBkId"       text="Booking ID"  prefWidth="120"/>
            <TableColumn fx:id="colDashCustomer"   text="Customer"    prefWidth="180"/>
            <TableColumn fx:id="colDashRoom"       text="Room #"      prefWidth="90"/>
            <TableColumn fx:id="colDashDays"       text="Days"        prefWidth="80"/>
            <TableColumn fx:id="colDashTotal"      text="Total (Rs.)" prefWidth="130"/>
            <TableColumn fx:id="colDashStatus"     text="Status"      prefWidth="110"/>
        </columns>
        <placeholder><Label text="No active bookings."/></placeholder>
    </TableView>

</VBox>
